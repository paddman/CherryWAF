[Unit]
Description=CherryWAF reverse proxy web application firewall
Documentation=https://github.com/paddman/CherryWAF
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cherrywaf
Group=cherrywaf
EnvironmentFile=-/etc/cherrywaf/cherrywaf.env
ExecStartPre=/usr/local/bin/cherrywaf validate-config --config /etc/cherrywaf/cherrywaf.json
ExecStart=/usr/local/bin/cherrywaf serve --config /etc/cherrywaf/cherrywaf.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
LimitNOFILE=1048576

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/cherrywaf
ReadWritePaths=/var/log/cherrywaf /var/lib/cherrywaf
UMask=0027

[Install]
WantedBy=multi-user.target
